# Ignore everything by default
*

# Keep only the specific folders we want in the repo.
# NOT including .venv/, .vscode/, Outputs/, or Thesis.code-workspace here
# means they stay excluded without needing an explicit deny rule.
!Data/
!Scripts/

# Keep repo metadata files
!.gitignore
!README.md

# Keep script sources inside Scripts/
!Scripts/**/*.py
!Scripts/**/*.ipynb

# Keep Excel data files inside Data/
!Data/**/*.xls
!Data/**/*.xlsx
!Data/**/*.xlsm

# Keep PDF and LaTeX source files in the project root or subfolders
!*.pdf
!*.tex
!*.bib
!*.cls
!*.sty

# Exclude administrative/cover documents (must come after the !*.pdf rule)
Thesis_Vademecum.pdf
ESL-ESN-Thesis Cover UNIMI.docx

# Exclude everything inside Latex/ (sources, build artifacts, figures)
# except the compiled PDF, which is the only thing we sync from there.
# Must come after the generic !*.tex/!*.bib rules above so it wins (last
# matching pattern takes precedence), and must un-ignore the directory
# itself first, same as !Data/ and !Scripts/ above, or git never
# traverses into it to see the rules below.
!Latex/
Latex/*
!Latex/main.pdf

